generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Puppy {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  sex         String
  birthDate   DateTime
  color       String
  price       Int
  currency    String   @default("EUR")
  status      String   @default("Available") // Available | Reserved | Sold
  litter      String?
  description String
  sire        String
  dam         String
  sireHD      String?
  sireED      String?
  damHD       String?
  damED       String?
  dna         String?
  images      String   // JSON array of image URLs
  videos      String?  // JSON array of video URLs
  pedigree    String?  // JSON pedigree data
  deposit     Int      @default(500)
  availableFrom DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  certificates Certificate[]
  inquiries    Inquiry[]
  applications Application[]
  reservations Reservation[]
  appointments Appointment[]
}

model Appointment {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  date        DateTime
  timeSlot    String
  type        String   @default("Visit") // Visit | Video call | Pickup
  notes       String?
  status      String   @default("Pending") // Pending | Confirmed | Cancelled
  createdAt   DateTime @default(now())
  puppyId     String?
  puppy       Puppy?   @relation(fields: [puppyId], references: [id])
}

model Certificate {
  id        String @id @default(cuid())
  name      String
  type      String // HD | ED | DNA
  fileUrl   String
  puppyId   String
  puppy     Puppy  @relation(fields: [puppyId], references: [id], onDelete: Cascade)
}

model Inquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  country     String?
  puppyName   String?
  experience  String?
  purpose     String?
  message     String
  status      String   @default("New") // New | Contacted | Closed
  createdAt   DateTime @default(now())
  puppyId     String?
  puppy       Puppy?   @relation(fields: [puppyId], references: [id])
}

model Application {
  id              String   @id @default(cuid())
  name            String
  email           String
  phone           String?
  country         String?
  address         String?
  experience      String?
  purpose         String?
  homeType        String?  // House | Apartment | Farm
  hasYard         Boolean  @default(false)
  otherPets       String?
  children        String?
  workSchedule    String?
  trainingPlans   String?
  whyMalinois     String?
  message         String?
  preferredPuppy  String?
  status          String   @default("Pending") // Pending | Approved | Rejected | Waitlist
  createdAt       DateTime @default(now())
  puppyId         String?
  puppy           Puppy?   @relation(fields: [puppyId], references: [id])
}

model Reservation {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  notes     String?
  status    String   @default("Requested") // Requested | Confirmed | Cancelled
  createdAt DateTime @default(now())
  puppyId   String
  puppy     Puppy    @relation(fields: [puppyId], references: [id], onDelete: Cascade)
}

model WaitingList {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  country     String?
  preferences String?  // sex, color, purpose etc
  notes       String?
  status      String   @default("Active") // Active | Contacted | Placed | Removed
  createdAt   DateTime @default(now())
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  name      String
  location  String?
  rating    Int      // 1-5
  title     String?
  content   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Contract {
  id          String   @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  category    String   @default("Purchase") // Purchase | Health Guarantee | Deposit
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Admin {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  name         String?
}
